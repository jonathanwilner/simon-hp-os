index 0000000..f1fe6bc
--- /dev/null
+++ b/src/input/touch_swipe_tracker.rs
@@ -0,0 +1,923 @@
+//! Touch swipe gesture tracker.
+//!
+//! Tracks active touch slots and recognizes when 3+ fingers are swiping together in the same
+//! direction, producing synthetic gesture begin / update / end signals. Also recognizes taps:
+//! all fingers going down and up within a short window without enough movement to become a
+//! swipe. And it distinguishes quick swipes from "hold then swipe" gestures by how long the
+//! fingers linger below the movement threshold before crossing it.
+
+use std::collections::HashMap;
+use std::time::Duration;
+
+use smithay::backend::input::TouchSlot;
+use smithay::utils::{Logical, Point};
+
+/// Emit a `gesture-debug:` log line, but only when the user opted in with
+/// `gestures { debug-log }`. The lines are the per-finger event stream used
+/// for remote debugging of gesture issues; they go to info so they survive
+/// any RUST_LOG the session runs with.
+macro_rules! gesture_debug {
+    ($self:expr, $($arg:tt)*) => {
+        if $self.debug_log {
+            info!("gesture-debug: {}", format_args!($($arg)*));
+        }
+    };
+}
+
+/// Recognition threshold in logical pixels. The cumulative movement of the centroid must exceed
+/// this before a gesture is recognized. Copied from GNOME Shell / libadwaita (same as touchpad).
+const GESTURE_THRESHOLD_PX: f64 = 16.0;
+
+/// Maximum time from the first finger down to the last finger up for the touch sequence to
+/// count as a tap rather than a cancelled gesture.
+const TAP_MAX_DURATION: Duration = Duration::from_millis(250);
+
+/// Minimum time from reaching the minimum finger count to crossing the movement threshold
+/// for the swipe to classify as a hold-swipe rather than a quick swipe. Same ballpark as
+/// libinput's long-press timeout; quick deliberate swipes cross the threshold far faster.
+const HOLD_THRESHOLD: Duration = Duration::from_millis(400);
+
+/// Default minimum number of simultaneous touch points required to start a gesture.
+#[cfg(test)]
+const DEFAULT_MIN_FINGERS: usize = 3;
+
+/// Maximum number of touch slots we track (sanity bound).
+const MAX_SLOTS: usize = 10;
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum SwipeDirection {
+    Horizontal,
+    Vertical,
+}
+
+#[derive(Debug, Clone, Copy, PartialEq)]
+pub enum GestureEvent {
+    Begin {
+        direction: SwipeDirection,
+        delta_x: f64,
+        delta_y: f64,
+        /// Number of fingers tracked when the gesture recognized.
+        fingers: usize,
+        timestamp: Duration,
+    },
+    Update {
+        delta_x: f64,
+        delta_y: f64,
+        timestamp: Duration,
+    },
+    End {
+        timestamp: Duration,
+    },
+    /// All fingers lifted quickly without enough movement to become a swipe.
+    Tap {
+        /// Maximum number of simultaneous fingers reached during the tap.
+        fingers: usize,
+        timestamp: Duration,
+    },
+    /// The movement threshold was crossed slowly: the fingers rested below it
+    /// for at least `HOLD_THRESHOLD` before moving. Like `Begin`, but the
+    /// handler resolves it to a discrete action instead of an animated gesture
+    /// when one is bound for the dominant direction.
+    HoldSwipe {
+        direction: SwipeDirection,
+        delta_x: f64,
+        delta_y: f64,
+        /// Number of fingers tracked when the gesture recognized.
+        fingers: usize,
+        timestamp: Duration,
+    },
+    Cancel,
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+enum Phase {
+    /// Collecting touch-down events, not yet enough fingers.
+    Idle,
+    /// We have enough slots but haven't exceeded the movement threshold yet.
+    Recognizing,
+    /// Gesture is active: direction is locked and we emit updates.
+    Active,
+}
+
+#[derive(Debug)]
+pub struct TouchSwipeGestureTracker {
+    /// All currently tracked touch slots and their latest positions.
+    slots: HashMap<TouchSlot, Point<f64, Logical>>,
+    /// The slots that were present when we entered the Recognizing phase. These are the ones whose
+    /// movement we average for the centroid delta. Fixed once recognition begins.
+    tracked_slots: Vec<TouchSlot>,
+    /// Positions of the tracked slots at the moment we entered Recognizing.
+    start_positions: HashMap<TouchSlot, Point<f64, Logical>>,
+    /// Previous centroid position, used to compute per-update deltas.
+    prev_centroid: Point<f64, Logical>,
+    phase: Phase,
+    direction: SwipeDirection,
+    /// Minimum number of simultaneous touch points required to start a gesture.
+    min_fingers: usize,
+    /// When the current touch sequence started (first finger down); used for tap detection.
+    first_down: Option<Duration>,
+    /// When the minimum finger count was reached (start of the Recognizing phase); used to
+    /// classify threshold crossings as quick swipes or hold-swipes.
+    recognize_started: Option<Duration>,
+    /// Maximum simultaneous fingers seen during the current touch sequence.
+    max_slots: usize,
+    /// Emit the `gesture-debug:` event stream (see `gestures { debug-log }`).
+    debug_log: bool,
+}
+
+impl TouchSwipeGestureTracker {
+    pub fn new(min_fingers: usize, debug_log: bool) -> Self {
+        Self {
+            slots: HashMap::new(),
+            tracked_slots: Vec::new(),
+            start_positions: HashMap::new(),
+            prev_centroid: Point::from((0.0, 0.0)),
+            phase: Phase::Idle,
+            direction: SwipeDirection::Horizontal,
+            min_fingers,
+            first_down: None,
+            recognize_started: None,
+            max_slots: 0,
+            debug_log,
+        }
+    }
+
+    /// Toggle the `gesture-debug:` event stream (live config reload).
+    pub fn set_debug_log(&mut self, on: bool) {
+        self.debug_log = on;
+    }
+
+    /// Returns `true` if a gesture is currently active (recognized and emitting updates).
+    pub fn is_active(&self) -> bool {
+        self.phase == Phase::Active
+    }
+
+    /// Returns `true` once enough fingers are down for a gesture (pre-threshold).
+    ///
+    /// While this holds, the sequence is compositor-owned: client delivery is
+    /// suspended so apps don't gesture-ize (pinch, drag-select) the touches.
+    pub fn is_recognizing(&self) -> bool {
+        self.phase == Phase::Recognizing
+    }
+
+    /// Returns `true` when no sequence is in progress (no slots tracked).
+    pub fn is_idle(&self) -> bool {
+        self.phase == Phase::Idle
+    }
+
+    /// The currently tracked touch slots.
+    ///
+    /// Used to end client-visible touches with synthetic lift events when the
+    /// compositor takes ownership of the sequence.
+    pub fn slots(&self) -> impl Iterator<Item = TouchSlot> + '_ {
+        self.slots.keys().copied()
+    }
+
+    /// Returns the locked direction of the current gesture.
+    ///
+    /// Only meaningful when `is_active()` returns `true`.
+    pub fn direction(&self) -> SwipeDirection {
+        self.direction
+    }
+
+    pub fn touch_down(
+        &mut self,
+        slot: TouchSlot,
+        pos: Point<f64, Logical>,
+        timestamp: Duration,
+    ) -> Option<GestureEvent> {
+        // If a gesture is already active, ignore additional fingers.
+        if self.phase == Phase::Active {
+            gesture_debug!(
+                self,
+                "down slot={} pos=({:.0},{:.0}) t={:?} IGNORED: gesture already active with {} fingers",
+                i32::from(slot),
+                pos.x,
+                pos.y,
+                timestamp,
+                self.tracked_slots.len()
+            );
+            trace!("touch_swipe: ignoring extra touch_down while active");
+            return None;
+        }
+
+        // Enforce the slot limit.
+        if self.slots.len() >= MAX_SLOTS {
+            trace!("touch_swipe: ignoring touch_down, at slot limit");
+            return None;
+        }
+
+        if self.slots.is_empty() {
+            self.first_down = Some(timestamp);
+        }
+
+        self.slots.insert(slot, pos);
+        self.max_slots = self.max_slots.max(self.slots.len());
+
+        gesture_debug!(
+            self,
+            "down slot={} pos=({:.0},{:.0}) t={:?} fingers={} phase={:?}",
+            i32::from(slot),
+            pos.x,
+            pos.y,
+            timestamp,
+            self.slots.len(),
+            self.phase
+        );
+
+        // Transition from Idle to Recognizing once we have enough fingers.
+        if self.phase == Phase::Idle && self.slots.len() >= self.min_fingers {
+            debug!(
+                "touch_swipe: entering recognizing phase with {} slots",
+                self.slots.len()
+            );
+            self.phase = Phase::Recognizing;
+            self.tracked_slots = self.slots.keys().copied().collect();
+            self.start_positions = self.slots.clone();
+            self.prev_centroid = self.centroid_of_tracked();
+            self.recognize_started = Some(timestamp);
+            gesture_debug!(
+                self,
+                "recognizing: tracking {} of {} slots (min {})",
+                self.tracked_slots.len(),
+                self.slots.len(),
+                self.min_fingers
+            );
+        } else if self.phase == Phase::Recognizing {
+            // An additional finger landing before the movement threshold is
+            // crossed joins the gesture (it counts toward the reported finger
+            // count and the centroid).
+            self.tracked_slots.push(slot);
+            self.start_positions.insert(slot, pos);
+            gesture_debug!(
+                self,
+                "late join: slot={} now tracking {} fingers",
+                i32::from(slot),
+                self.tracked_slots.len()
+            );
+        }
+
+        None
+    }
+
+    pub fn touch_motion(
+        &mut self,
+        slot: TouchSlot,
+        pos: Point<f64, Logical>,
+        timestamp: Duration,
+    ) -> Option<GestureEvent> {
+        // Update stored position regardless of phase.
+        if let Some(stored) = self.slots.get_mut(&slot) {
+            *stored = pos;
+        } else {
+            // Motion for unknown slot — ignore.
+            return None;
+        }
+
+        // Only log motion once a sequence is underway; single-finger app
+        // scrolling in Idle would flood the stream.
+        if self.phase != Phase::Idle {
+            gesture_debug!(
+                self,
+                "motion slot={} pos=({:.0},{:.0}) t={:?} fingers={}",
+                i32::from(slot),
+                pos.x,
+                pos.y,
+                timestamp,
+                self.slots.len()
+            );
+        }
+
+        match self.phase {
+            Phase::Idle => None,
+            Phase::Recognizing => self.try_recognize(timestamp),
+            Phase::Active => {
+                // Only emit updates for motion on tracked slots.
+                if !self.tracked_slots.contains(&slot) {
+                    return None;
+                }
+                let centroid = self.centroid_of_tracked();
+                let dx = centroid.x - self.prev_centroid.x;
+                let dy = centroid.y - self.prev_centroid.y;
+                self.prev_centroid = centroid;
+
+                Some(GestureEvent::Update {
+                    delta_x: dx,
+                    delta_y: dy,
+                    timestamp,
+                })
+            }
+        }
+    }
+
+    pub fn touch_up(&mut self, slot: TouchSlot, timestamp: Duration) -> Option<GestureEvent> {
+        self.slots.remove(&slot);
+
+        match self.phase {
+            Phase::Active => {
+                // If one of the original tracked slots lifts, end the gesture.
+                if self.tracked_slots.contains(&slot) {
+                    gesture_debug!(
+                        self,
+                        "up slot={} t={:?} fingers={}: tracked finger lifted, ending gesture",
+                        i32::from(slot),
+                        timestamp,
+                        self.slots.len()
+                    );
+                    trace!("touch_swipe: tracked slot lifted, ending gesture");
+                    self.reset_internal();
+                    Some(GestureEvent::End { timestamp })
+                } else {
+                    gesture_debug!(
+                        self,
+                        "up slot={} t={:?} fingers={}: untracked finger (gesture continues)",
+                        i32::from(slot),
+                        timestamp,
+                        self.slots.len()
+                    );
+                    None
+                }
+            }
+            Phase::Recognizing => {
+                // A finger lifted before recognition. This may be a tap ending
+                // (fingers lifting one after another) or a fizzle; wait until
+                // all fingers are up before deciding.
+                self.tracked_slots.retain(|s| *s != slot);
+                self.start_positions.remove(&slot);
+                gesture_debug!(
+                    self,
+                    "up slot={} t={:?} fingers={} phase=Recognizing",
+                    i32::from(slot),
+                    timestamp,
+                    self.slots.len()
+                );
+                if self.slots.is_empty() {
+                    let is_tap = self
+                        .first_down
+                        .and_then(|t0| timestamp.checked_sub(t0))
+                        .is_some_and(|elapsed| elapsed <= TAP_MAX_DURATION);
+                    let fingers = self.max_slots;
+                    self.reset_internal();
+                    if is_tap {
+                        debug!("touch_swipe: tap detected ({fingers} fingers)");
+                        gesture_debug!(self, "tap: {} fingers (max simultaneous)", fingers);
+                        Some(GestureEvent::Tap { fingers, timestamp })
+                    } else {
+                        gesture_debug!(
+                            self,
+                            "cancel: {} fingers lifted too slowly for a tap",
+                            fingers
+                        );
+                        Some(GestureEvent::Cancel)
+                    }
+                } else {
+                    None
+                }
+            }
+            Phase::Idle => None,
+        }
+    }
+
+    /// Resets the tracker to its idle state, cancelling any in-progress gesture.
+    pub fn reset(&mut self) {
+        self.reset_internal();
+    }
+
+    fn reset_internal(&mut self) {
+        self.slots.clear();
+        self.tracked_slots.clear();
+        self.start_positions.clear();
+        self.prev_centroid = Point::from((0.0, 0.0));
+        self.phase = Phase::Idle;
+        self.direction = SwipeDirection::Horizontal;
+        self.first_down = None;
+        self.recognize_started = None;
+        self.max_slots = 0;
+        // min_fingers and debug_log are intentionally preserved across resets.
+    }
+
+    /// Compute the centroid of the currently tracked slots.
+    fn centroid_of_tracked(&self) -> Point<f64, Logical> {
+        let n = self.tracked_slots.len() as f64;
+        if n == 0.0 {
+            return Point::from((0.0, 0.0));
+        }
+
+        let mut sum_x = 0.0;
+        let mut sum_y = 0.0;
+        for slot in &self.tracked_slots {
+            if let Some(pos) = self.slots.get(slot) {
+                sum_x += pos.x;
+                sum_y += pos.y;
+            }
+        }
+        Point::from((sum_x / n, sum_y / n))
+    }
+
+    /// Check whether cumulative movement of the centroid exceeds the threshold.
+    fn try_recognize(&mut self, timestamp: Duration) -> Option<GestureEvent> {
+        let centroid = self.centroid_of_tracked();
+        let start_centroid = {
+            let n = self.tracked_slots.len() as f64;
+            if n == 0.0 {
+                return None;
+            }
+            let mut sx = 0.0;
+            let mut sy = 0.0;
+            for slot in &self.tracked_slots {
+                if let Some(pos) = self.start_positions.get(slot) {
+                    sx += pos.x;
+                    sy += pos.y;
+                }
+            }
+            Point::<f64, Logical>::from((sx / n, sy / n))
+        };
+
+        let dx = centroid.x - start_centroid.x;
+        let dy = centroid.y - start_centroid.y;
+        let dist_sq = dx * dx + dy * dy;
+
+        if dist_sq < GESTURE_THRESHOLD_PX * GESTURE_THRESHOLD_PX {
+            return None;
+        }
+
+        // Lock the direction based on which axis has more movement.
+        self.direction = if dx.abs() > dy.abs() {
+            SwipeDirection::Horizontal
+        } else {
+            SwipeDirection::Vertical
+        };
+
+        self.phase = Phase::Active;
+        self.prev_centroid = centroid;
+
+        // Did the fingers linger below the threshold before crossing it?
+        let held = self
+            .recognize_started
+            .and_then(|t0| timestamp.checked_sub(t0))
+            .is_some_and(|elapsed| elapsed >= HOLD_THRESHOLD);
+
+        if held {
+            debug!(
+                "touch_swipe: hold-swipe recognized as {:?}, delta ({dx:.1}, {dy:.1})",
+                self.direction
+            );
+            gesture_debug!(
+                self,
+                "recognized: HOLD-swipe fingers={} direction={:?} delta=({:.1},{:.1}) t={:?}",
+                self.tracked_slots.len(),
+                self.direction,
+                dx,
+                dy,
+                timestamp
+            );
+            return Some(GestureEvent::HoldSwipe {
+                direction: self.direction,
+                delta_x: dx,
+                delta_y: dy,
+                fingers: self.tracked_slots.len(),
+                timestamp,
+            });
+        }
+
+        trace!(
+            "touch_swipe: gesture recognized as {:?}, delta ({dx:.1}, {dy:.1})",
+            self.direction
+        );
+
+        gesture_debug!(
+            self,
+            "recognized: swipe fingers={} direction={:?} delta=({:.1},{:.1}) t={:?}",
+            self.tracked_slots.len(),
+            self.direction,
+            dx,
+            dy,
+            timestamp
+        );
+
+        Some(GestureEvent::Begin {
+            direction: self.direction,
+            delta_x: dx,
+            delta_y: dy,
+            fingers: self.tracked_slots.len(),
+            timestamp,
+        })
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn slot(id: u32) -> TouchSlot {
+        TouchSlot::from(Some(id))
+    }
+
+    fn pt(x: f64, y: f64) -> Point<f64, Logical> {
+        Point::from((x, y))
+    }
+
+    fn ts(millis: u64) -> Duration {
+        Duration::from_millis(millis)
+    }
+
+    #[test]
+    fn no_gesture_with_fewer_than_three_fingers() {
+        let mut tracker = TouchSwipeGestureTracker::new(DEFAULT_MIN_FINGERS, false);
+        assert!(tracker.touch_down(slot(0), pt(100.0, 100.0), ts(0)).is_none());
+        assert!(tracker.touch_down(slot(1), pt(110.0, 100.0), ts(0)).is_none());
+        // Move them a lot — still no gesture.
+        assert!(tracker
+            .touch_motion(slot(0), pt(200.0, 100.0), ts(10))
+            .is_none());
+        assert!(tracker
+            .touch_motion(slot(1), pt(210.0, 100.0), ts(10))
+            .is_none());
+        assert!(!tracker.is_active());
+    }
+
+    #[test]
+    fn gesture_begins_after_threshold_with_three_fingers() {
+        let mut tracker = TouchSwipeGestureTracker::new(DEFAULT_MIN_FINGERS, false);
+        tracker.touch_down(slot(0), pt(100.0, 100.0), ts(0));
+        tracker.touch_down(slot(1), pt(110.0, 100.0), ts(0));
+        tracker.touch_down(slot(2), pt(120.0, 100.0), ts(0));
+
+        assert!(!tracker.is_active());
+
+        // Move all fingers a small amount — below threshold.
+        tracker.touch_motion(slot(0), pt(105.0, 100.0), ts(10));
+        tracker.touch_motion(slot(1), pt(115.0, 100.0), ts(10));
+        let ev = tracker.touch_motion(slot(2), pt(125.0, 100.0), ts(10));
+        assert!(ev.is_none());
+
+        // Move all fingers beyond threshold horizontally (20px each).
+        tracker.touch_motion(slot(0), pt(120.0, 100.0), ts(20));
+        tracker.touch_motion(slot(1), pt(130.0, 100.0), ts(20));
+        let ev = tracker.touch_motion(slot(2), pt(140.0, 100.0), ts(20));
+        assert!(matches!(
+            ev,
+            Some(GestureEvent::Begin {
+                direction: SwipeDirection::Horizontal,
+                ..
+            })
+        ));
+        assert!(tracker.is_active());
+        assert_eq!(tracker.direction(), SwipeDirection::Horizontal);
+    }
+
+    #[test]
+    fn vertical_direction_detected() {
+        let mut tracker = TouchSwipeGestureTracker::new(DEFAULT_MIN_FINGERS, false);
+        tracker.touch_down(slot(0), pt(100.0, 100.0), ts(0));
+        tracker.touch_down(slot(1), pt(110.0, 100.0), ts(0));
+        tracker.touch_down(slot(2), pt(120.0, 100.0), ts(0));
+
+        // Move all fingers down past threshold (20px each).
+        tracker.touch_motion(slot(0), pt(100.0, 120.0), ts(10));
+        tracker.touch_motion(slot(1), pt(110.0, 120.0), ts(10));
+        let ev = tracker.touch_motion(slot(2), pt(120.0, 120.0), ts(10));
+
+        assert!(matches!(
+            ev,
+            Some(GestureEvent::Begin {
+                direction: SwipeDirection::Vertical,
+                ..
+            })
+        ));
+    }
+
+    #[test]
+    fn phase_accessors_track_finger_count() {
+        let mut tracker = TouchSwipeGestureTracker::new(DEFAULT_MIN_FINGERS, false);
+        assert!(tracker.is_idle());
+
+        tracker.touch_down(slot(0), pt(100.0, 100.0), ts(0));
+        tracker.touch_down(slot(1), pt(110.0, 100.0), ts(0));
+        // Below the gesture finger count: not compositor-owned yet.
+        assert!(tracker.is_idle());
+
+        tracker.touch_down(slot(2), pt(120.0, 100.0), ts(0));
+        assert!(tracker.is_recognizing());
+
+        // Cross the threshold: active (still compositor-owned).
+        tracker.touch_motion(slot(0), pt(80.0, 100.0), ts(10));
+        tracker.touch_motion(slot(1), pt(90.0, 100.0), ts(10));
+        tracker.touch_motion(slot(2), pt(100.0, 100.0), ts(10));
+        assert!(tracker.is_active());
+
+        // End the gesture: back to idle, client delivery can resume.
+        tracker.touch_up(slot(0), ts(20));
+        tracker.touch_up(slot(1), ts(21));
+        tracker.touch_up(slot(2), ts(22));
+        assert!(tracker.is_idle());
+    }
+
+    #[test]
+    fn hold_swipe_detected_after_slow_threshold_crossing() {
+        let mut tracker = TouchSwipeGestureTracker::new(DEFAULT_MIN_FINGERS, false);
+        tracker.touch_down(slot(0), pt(100.0, 100.0), ts(0));
+        tracker.touch_down(slot(1), pt(110.0, 100.0), ts(0));
+        tracker.touch_down(slot(2), pt(120.0, 100.0), ts(0));
+
+        // Fingers rest still for a while, then move left past the threshold.
+        tracker.touch_motion(slot(0), pt(95.0, 100.0), ts(100));
+        tracker.touch_motion(slot(1), pt(105.0, 100.0), ts(100));
+        assert!(tracker
+            .touch_motion(slot(2), pt(115.0, 100.0), ts(100))
+            .is_none());
+
+        tracker.touch_motion(slot(0), pt(80.0, 100.0), ts(500));
+        tracker.touch_motion(slot(1), pt(90.0, 100.0), ts(500));
+        let ev = tracker.touch_motion(slot(2), pt(100.0, 100.0), ts(500));
+
+        match ev {
+            Some(GestureEvent::HoldSwipe {
+                direction,
+                delta_x,
+                delta_y,
+                fingers,
+                ..
+            }) => {
+                assert_eq!(direction, SwipeDirection::Horizontal);
+                // Centroid moved from 110 to 90: 20px to the left.
+                assert_eq!(delta_x, -20.0);
+                assert_eq!(delta_y, 0.0);
+                assert_eq!(fingers, 3);
+            }
+            other => panic!("expected HoldSwipe, got {other:?}"),
+        }
+        assert!(tracker.is_active());
+    }
+
+    #[test]
+    fn hold_swipe_vertical_carries_sign() {
+        let mut tracker = TouchSwipeGestureTracker::new(DEFAULT_MIN_FINGERS, false);
+        tracker.touch_down(slot(0), pt(100.0, 100.0), ts(0));
+        tracker.touch_down(slot(1), pt(110.0, 100.0), ts(0));
+        tracker.touch_down(slot(2), pt(120.0, 100.0), ts(0));
+
+        // Held, then dragged down past the threshold.
+        tracker.touch_motion(slot(0), pt(100.0, 120.0), ts(450));
+        tracker.touch_motion(slot(1), pt(110.0, 120.0), ts(450));
+        let ev = tracker.touch_motion(slot(2), pt(120.0, 120.0), ts(450));
+
+        match ev {
+            Some(GestureEvent::HoldSwipe {
+                direction,
+                delta_y,
+                ..
+            }) => {
+                assert_eq!(direction, SwipeDirection::Vertical);
+                // Positive delta = downward on screen.
+                assert_eq!(delta_y, 20.0);
+            }
+            other => panic!("expected HoldSwipe, got {other:?}"),
+        }
+    }
+
+    #[test]
+    fn threshold_crossed_before_hold_threshold_is_quick_swipe() {
+        let mut tracker = TouchSwipeGestureTracker::new(DEFAULT_MIN_FINGERS, false);
+        tracker.touch_down(slot(0), pt(100.0, 100.0), ts(0));
+        tracker.touch_down(slot(1), pt(110.0, 100.0), ts(0));
+        tracker.touch_down(slot(2), pt(120.0, 100.0), ts(0));
+
+        // 399ms: still a quick swipe, not a hold-swipe.
+        tracker.touch_motion(slot(0), pt(80.0, 100.0), ts(399));
+        tracker.touch_motion(slot(1), pt(90.0, 100.0), ts(399));
+        let ev = tracker.touch_motion(slot(2), pt(100.0, 100.0), ts(399));
+
+        assert!(matches!(ev, Some(GestureEvent::Begin { .. })));
+    }
+
+    #[test]
+    fn hold_clock_starts_at_the_last_finger_landing() {
+        let mut tracker = TouchSwipeGestureTracker::new(DEFAULT_MIN_FINGERS, false);
+        tracker.touch_down(slot(0), pt(100.0, 100.0), ts(0));
+        tracker.touch_down(slot(1), pt(110.0, 100.0), ts(0));
+        // Third finger lands late: the hold clock must start here, not at 0.
+        tracker.touch_down(slot(2), pt(120.0, 100.0), ts(300));
+
+        // Crossing at 500ms is only 200ms after the gesture became possible.
+        tracker.touch_motion(slot(0), pt(80.0, 100.0), ts(500));
+        tracker.touch_motion(slot(1), pt(90.0, 100.0), ts(500));
+        let ev = tracker.touch_motion(slot(2), pt(100.0, 100.0), ts(500));
+
+        assert!(matches!(ev, Some(GestureEvent::Begin { .. })));
+    }
+
+    #[test]
+    fn hold_without_movement_lifts_to_cancel_not_tap() {
+        let mut tracker = TouchSwipeGestureTracker::new(DEFAULT_MIN_FINGERS, false);
+        tracker.touch_down(slot(0), pt(100.0, 100.0), ts(0));
+        tracker.touch_down(slot(1), pt(110.0, 100.0), ts(0));
+        tracker.touch_down(slot(2), pt(120.0, 100.0), ts(0));
+
+        // Lift after a long still hold: too slow for a tap, never moved.
+        assert!(tracker.touch_up(slot(0), ts(500)).is_none());
+        assert!(tracker.touch_up(slot(1), ts(510)).is_none());
+        assert!(matches!(tracker.touch_up(slot(2), ts(520)), Some(GestureEvent::Cancel)));
+    }
+
+    #[test]
+    fn updates_emit_centroid_delta() {
+        let mut tracker = TouchSwipeGestureTracker::new(DEFAULT_MIN_FINGERS, false);
+        tracker.touch_down(slot(0), pt(100.0, 100.0), ts(0));
+        tracker.touch_down(slot(1), pt(110.0, 100.0), ts(0));
+        tracker.touch_down(slot(2), pt(120.0, 100.0), ts(0));
+
+        // Trigger recognition by moving right.
+        tracker.touch_motion(slot(0), pt(120.0, 100.0), ts(10));
+        tracker.touch_motion(slot(1), pt(130.0, 100.0), ts(10));
+        let begin = tracker.touch_motion(slot(2), pt(140.0, 100.0), ts(10));
+        assert!(begin.is_some());
+
+        // Now move slot 0 by 9px right.
+        let ev = tracker.touch_motion(slot(0), pt(129.0, 100.0), ts(20));
+        match ev {
+            Some(GestureEvent::Update {
+                delta_x, delta_y, ..
+            }) => {
+                // Only slot 0 moved 9px, centroid delta = 9 / 3 = 3.
+                assert!((delta_x - 3.0).abs() < 0.01);
+                assert!(delta_y.abs() < 0.01);
+            }
+            other => panic!("expected Update, got {other:?}"),
+        }
+    }
+
+    #[test]
+    fn gesture_ends_on_tracked_slot_lift() {
+        let mut tracker = TouchSwipeGestureTracker::new(DEFAULT_MIN_FINGERS, false);
+        tracker.touch_down(slot(0), pt(100.0, 100.0), ts(0));
+        tracker.touch_down(slot(1), pt(110.0, 100.0), ts(0));
+        tracker.touch_down(slot(2), pt(120.0, 100.0), ts(0));
+
+        // Trigger recognition.
+        tracker.touch_motion(slot(0), pt(120.0, 100.0), ts(10));
+        tracker.touch_motion(slot(1), pt(130.0, 100.0), ts(10));
+        tracker.touch_motion(slot(2), pt(140.0, 100.0), ts(10));
+        assert!(tracker.is_active());
+
+        // Lift one tracked finger.
+        let ev = tracker.touch_up(slot(1), ts(30));
+        assert!(matches!(ev, Some(GestureEvent::End { .. })));
+        assert!(!tracker.is_active());
+    }
+
+    #[test]
+    fn extra_finger_ignored_during_active_gesture() {
+        let mut tracker = TouchSwipeGestureTracker::new(DEFAULT_MIN_FINGERS, false);
+        tracker.touch_down(slot(0), pt(100.0, 100.0), ts(0));
+        tracker.touch_down(slot(1), pt(110.0, 100.0), ts(0));
+        tracker.touch_down(slot(2), pt(120.0, 100.0), ts(0));
+
+        // Trigger recognition.
+        tracker.touch_motion(slot(0), pt(120.0, 100.0), ts(10));
+        tracker.touch_motion(slot(1), pt(130.0, 100.0), ts(10));
+        tracker.touch_motion(slot(2), pt(140.0, 100.0), ts(10));
+        assert!(tracker.is_active());
+
+        // Add a 4th finger.
+        let ev = tracker.touch_down(slot(3), pt(200.0, 200.0), ts(15));
+        assert!(ev.is_none());
+
+        // Lifting the 4th finger doesn't end the gesture.
+        let ev = tracker.touch_up(slot(3), ts(40));
+        assert!(ev.is_none());
+        assert!(tracker.is_active());
+    }
+
+    #[test]
+    fn tap_detected_when_fingers_lift_quickly() {
+        let mut tracker = TouchSwipeGestureTracker::new(DEFAULT_MIN_FINGERS, false);
+        tracker.touch_down(slot(0), pt(100.0, 100.0), ts(0));
+        tracker.touch_down(slot(1), pt(110.0, 100.0), ts(10));
+        tracker.touch_down(slot(2), pt(120.0, 100.0), ts(20));
+
+        // Lift them one after another, well within the tap window. The first
+        // lift drops below the finger minimum but must not decide yet.
+        assert!(tracker.touch_up(slot(2), ts(60)).is_none());
+        assert!(tracker.touch_up(slot(0), ts(70)).is_none());
+        let ev = tracker.touch_up(slot(1), ts(80));
+        assert!(matches!(ev, Some(GestureEvent::Tap { .. })));
+        assert!(!tracker.is_active());
+    }
+
+    #[test]
+    fn slow_touch_sequence_cancels_instead_of_tap() {
+        let mut tracker = TouchSwipeGestureTracker::new(DEFAULT_MIN_FINGERS, false);
+        tracker.touch_down(slot(0), pt(100.0, 100.0), ts(0));
+        tracker.touch_down(slot(1), pt(110.0, 100.0), ts(0));
+        tracker.touch_down(slot(2), pt(120.0, 100.0), ts(0));
+
+        // Fingers stay down long past the tap window.
+        assert!(tracker.touch_up(slot(2), ts(300)).is_none());
+        assert!(tracker.touch_up(slot(0), ts(310)).is_none());
+        let ev = tracker.touch_up(slot(1), ts(320));
+        assert!(matches!(ev, Some(GestureEvent::Cancel)));
+    }
+
+    #[test]
+    fn tap_below_finger_count_ignored() {
+        let mut tracker = TouchSwipeGestureTracker::new(DEFAULT_MIN_FINGERS, false);
+        tracker.touch_down(slot(0), pt(100.0, 100.0), ts(0));
+        tracker.touch_down(slot(1), pt(110.0, 100.0), ts(10));
+
+        // Two fingers never reach the recognizing phase, so no tap.
+        assert!(tracker.touch_up(slot(1), ts(50)).is_none());
+        assert!(tracker.touch_up(slot(0), ts(60)).is_none());
+    }
+
+    #[test]
+    fn tap_reports_max_finger_count() {
+        let mut tracker = TouchSwipeGestureTracker::new(DEFAULT_MIN_FINGERS, false);
+        tracker.touch_down(slot(0), pt(100.0, 100.0), ts(0));
+        tracker.touch_down(slot(1), pt(110.0, 100.0), ts(10));
+        tracker.touch_down(slot(2), pt(120.0, 100.0), ts(20));
+        // A fourth finger joins before the lift.
+        tracker.touch_down(slot(3), pt(130.0, 100.0), ts(30));
+
+        assert!(tracker.touch_up(slot(3), ts(60)).is_none());
+        assert!(tracker.touch_up(slot(2), ts(70)).is_none());
+        assert!(tracker.touch_up(slot(0), ts(80)).is_none());
+        match tracker.touch_up(slot(1), ts(90)) {
+            Some(GestureEvent::Tap { fingers, .. }) => assert_eq!(fingers, 4),
+            other => panic!("expected Tap, got {other:?}"),
+        }
+    }
+
+    #[test]
+    fn reset_clears_state() {
+        let mut tracker = TouchSwipeGestureTracker::new(DEFAULT_MIN_FINGERS, false);
+        tracker.touch_down(slot(0), pt(100.0, 100.0), ts(0));
+        tracker.touch_down(slot(1), pt(110.0, 100.0), ts(0));
+        tracker.touch_down(slot(2), pt(120.0, 100.0), ts(0));
+
+        // Trigger recognition.
+        tracker.touch_motion(slot(0), pt(120.0, 100.0), ts(10));
+        tracker.touch_motion(slot(1), pt(130.0, 100.0), ts(10));
+        tracker.touch_motion(slot(2), pt(140.0, 100.0), ts(10));
+        assert!(tracker.is_active());
+
+        tracker.reset();
+        assert!(!tracker.is_active());
+    }
+
+    #[test]
+    fn motion_on_unknown_slot_ignored() {
+        let mut tracker = TouchSwipeGestureTracker::new(DEFAULT_MIN_FINGERS, false);
+        let ev = tracker.touch_motion(slot(99), pt(0.0, 0.0), ts(10));
+        assert!(ev.is_none());
+    }
+
+    #[test]
+    fn four_fingers_down_before_recognition() {
+        let mut tracker = TouchSwipeGestureTracker::new(DEFAULT_MIN_FINGERS, false);
+        tracker.touch_down(slot(0), pt(100.0, 100.0), ts(0));
+        tracker.touch_down(slot(1), pt(110.0, 100.0), ts(0));
+        tracker.touch_down(slot(2), pt(120.0, 100.0), ts(0));
+        // 4th finger during recognizing phase joins the tracked slots.
+        tracker.touch_down(slot(3), pt(130.0, 100.0), ts(5));
+
+        // Move all right past threshold.
+        tracker.touch_motion(slot(0), pt(120.0, 100.0), ts(10));
+        tracker.touch_motion(slot(1), pt(130.0, 100.0), ts(10));
+        tracker.touch_motion(slot(2), pt(140.0, 100.0), ts(10));
+        let ev = tracker.touch_motion(slot(3), pt(150.0, 100.0), ts(10));
+
+        // Should recognize with all 4 fingers being tracked.
+        match ev {
+            Some(GestureEvent::Begin { fingers, .. }) => assert_eq!(fingers, 4),
+            _ => panic!("expected Begin with 4 fingers"),
+        }
+    }
+
+    #[test]
+    fn begin_delta_reflects_cumulative_movement() {
+        let mut tracker = TouchSwipeGestureTracker::new(DEFAULT_MIN_FINGERS, false);
+        tracker.touch_down(slot(0), pt(100.0, 100.0), ts(0));
+        tracker.touch_down(slot(1), pt(200.0, 100.0), ts(0));
+        tracker.touch_down(slot(2), pt(300.0, 100.0), ts(0));
+
+        // Move all three fingers 20px to the right.
+        tracker.touch_motion(slot(0), pt(120.0, 100.0), ts(10));
+        tracker.touch_motion(slot(1), pt(220.0, 100.0), ts(10));
+        let ev = tracker.touch_motion(slot(2), pt(320.0, 100.0), ts(10));
+
+        match ev {
+            Some(GestureEvent::Begin {
+                delta_x,
+                delta_y,
+                direction,
+                ..
+            }) => {
+                assert_eq!(direction, SwipeDirection::Horizontal);
+                assert!((delta_x - 20.0).abs() < 0.01);
+                assert!(delta_y.abs() < 0.01);
+            }
+            other => panic!("expected Begin, got {other:?}"),
+        }
+    }
+}
