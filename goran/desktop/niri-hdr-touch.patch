+    pub fn touch_down(
+        &mut self,
+        slot: TouchSlot,
+        pos: Point<f64, Logical>,
+        output_geom: Rectangle<f64, Logical>,
+    ) -> Option<SwipeZone> {
+        if self.tracked.is_some() {
+            // A second finger landed; this is not a clean single-finger gesture.
+            self.tracked = None;
+            return None;
+        }
+
+        let zone = SwipeZone::classify(pos, output_geom)?;
+        debug!(
+            "touch_edge_swipe: tracking zone {zone:?} from ({:.0},{:.0})",
+            pos.x, pos.y
+        );
+        self.tracked = Some(Tracked {
+            slot,
+            start: pos,
+            zone,
+            latched: false,
+        });
+        Some(zone)
