+/// The base finger count for touchscreen swipe gestures: 3 or 4.
+///
+/// A newtype so the parser can reject anything else at decode time: below 3
+/// clashes with standard touchscreen behavior, and above 4 the second
+/// gesture tier (`tap-more`, `swipe-more-*`) needs more fingers than one
+/// hand comfortably provides.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub struct FingerCount(pub u8);
+
+impl Default for FingerCount {
+    fn default() -> Self {
+        Self(3)
+    }
+}
+
+impl MergeWith<FingerCount> for u8 {
+    fn merge_with(&mut self, part: &FingerCount) {
+        *self = part.0;
+    }
+}
+
+impl<S: knuffel::traits::ErrorSpan> knuffel::DecodeScalar<S> for FingerCount {
+    fn type_check(
+        type_name: &Option<knuffel::span::Spanned<knuffel::ast::TypeName, S>>,
+        ctx: &mut knuffel::decode::Context<S>,
+    ) {
+        if let Some(type_name) = &type_name {
+            ctx.emit_error(DecodeError::unexpected(
+                type_name,
+                "type name",
+                "no type name expected for this node",
+            ));
+        }
+    }
+
+    fn raw_decode(
+        val: &knuffel::span::Spanned<knuffel::ast::Literal, S>,
+        ctx: &mut knuffel::decode::Context<S>,
+    ) -> Result<Self, DecodeError<S>> {
+        match &**val {
+            knuffel::ast::Literal::Int(ref value) => match value.try_into() {
+                Ok(v) if (3..=4).contains(&v) => Ok(Self(v)),
+                Ok(_) => {
+                    ctx.emit_error(DecodeError::conversion(
+                        val,
+                        "fingers must be 3 or 4",
+                    ));
+                    Ok(Self::default())
+                }
+                Err(e) => {
+                    ctx.emit_error(DecodeError::conversion(val, e));
+                    Ok(Self::default())
+                }
+            },
+            _ => {
+                ctx.emit_error(DecodeError::unsupported(
+                    val,
+                    "Unsupported value, only whole numbers are recognized",
+                ));
+                Ok(Self::default())
+            }
+        }
+    }
+}
