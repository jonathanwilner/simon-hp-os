@@ -0,0 +1,394 @@
+use std::time::Duration;
+
+use smithay::desktop::Window;
+use smithay::input::touch::{
+    DownEvent, GrabStartData as TouchGrabStartData, MotionEvent, OrientationEvent, ShapeEvent,
+    TouchGrab, TouchInnerHandle, UpEvent,
+};
+use smithay::input::SeatHandler;
+use smithay::output::Output;
+use smithay::utils::{IsAlive, Logical, Point};
+
+use crate::input::touch_swipe_tracker::{GestureEvent, SwipeDirection, TouchSwipeGestureTracker};
+use crate::niri::State;
+use crate::utils::ResizeEdge;
+use niri_config::Action;
+
+/// Gesture state for a 3-finger touchscreen swipe outside the overview.
+///
+/// Feeds deltas into the same `Layout::workspace_switch_gesture_*` and `view_offset_gesture_*`
+/// pipeline that the touchpad path uses.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+enum GestureState {
+    /// The tracker is still collecting fingers / hasn't exceeded the movement threshold.
+    Recognizing,
+    /// Horizontal swipe — drives `view_offset_gesture_*`.
+    ViewOffset,
+    /// Vertical swipe — drives `workspace_switch_gesture_*`.
+    WorkspaceSwitch,
+    /// Horizontal swipe in column-resize mode — drives
+    /// `Layout::interactive_resize_*` on the focused window.
+    ColumnResize,
+    /// Discrete gesture (bound quick flick): swallow events and run the pending
+    /// action when the gesture completes.
+    Discrete,
+}
+
+pub struct TouchSwipeGrab {
+    start_data: TouchGrabStartData<State>,
+    output: Output,
+    tracker: TouchSwipeGestureTracker,
+    gesture: GestureState,
+    /// Whether horizontal swipes should resize the focused window's width
+    /// (`touchscreen-swipe horizontal-swipe "resize-column"`).
+    resize_mode: bool,
+    /// Window being resized in `GestureState::ColumnResize`.
+    resize_window: Option<Window>,
+    /// Cumulative horizontal delta of the resize gesture, from its start.
+    resize_dx: f64,
+    /// Action to run when a discrete gesture completes.
+    pending_action: Option<Action>,
+}
+
+impl TouchSwipeGrab {
+    pub fn new(
+        start_data: TouchGrabStartData<State>,
+        output: Output,
+        tracker: TouchSwipeGestureTracker,
+        resize_mode: bool,
+    ) -> Self {
+        let gesture = if tracker.is_active() {
+            match tracker.direction() {
+                SwipeDirection::Horizontal => GestureState::ViewOffset,
+                SwipeDirection::Vertical => GestureState::WorkspaceSwitch,
+            }
+        } else {
+            GestureState::Recognizing
+        };
+
+        Self {
+            start_data,
+            output,
+            tracker,
+            gesture,
+            resize_mode,
+            resize_window: None,
+            resize_dx: 0.,
+            pending_action: None,
+        }
+    }
+
+    /// A horizontal swipe in column-resize mode: the caller has already begun
+    /// the interactive resize and applied `initial_delta_x`; the grab feeds
+    /// the remaining (incremental) deltas into `Layout::interactive_resize_*`
+    /// and ends the resize when the gesture completes.
+    pub fn new_column_resize(
+        start_data: TouchGrabStartData<State>,
+        output: Output,
+        tracker: TouchSwipeGestureTracker,
+        window: Window,
+        initial_delta_x: f64,
+    ) -> Self {
+        Self {
+            start_data,
+            output,
+            tracker,
+            gesture: GestureState::ColumnResize,
+            resize_mode: true,
+            resize_window: Some(window),
+            resize_dx: initial_delta_x,
+            pending_action: None,
+        }
+    }
+
+    /// A discrete swipe gesture: no animated layout gesture, just swallow the touch
+    /// events and run `action` when the gesture ends.
+    pub fn new_discrete(
+        start_data: TouchGrabStartData<State>,
+        output: Output,
+        tracker: TouchSwipeGestureTracker,
+        action: Action,
+    ) -> Self {
+        Self {
+            start_data,
+            output,
+            tracker,
+            gesture: GestureState::Discrete,
+            resize_mode: false,
+            resize_window: None,
+            resize_dx: 0.,
+            pending_action: Some(action),
+        }
+    }
+
+    fn handle_gesture_event(&mut self, event: Option<GestureEvent>, data: &mut State) -> bool {
+        let Some(event) = event else {
+            return false;
+        };
+
+        match event {
+            // A HoldSwipe here means the hold had no action bound, so it fell
+            // through to the animated gesture path — same handling as Begin.
+            GestureEvent::Begin {
+                direction,
+                delta_x,
+                delta_y,
+                timestamp,
+                ..
+            }
+            | GestureEvent::HoldSwipe {
+                direction,
+                delta_x,
+                delta_y,
+                timestamp,
+                ..
+            } => {
+                match direction {
+                    SwipeDirection::Horizontal => {
+                        let mut began_resize = false;
+                        if self.resize_mode {
+                            began_resize = self.begin_column_resize(data, delta_x);
+                        }
+
+                        if !began_resize {
+                            data.niri
+                                .layout
+                                .view_offset_gesture_begin(&self.output, None, false);
+                            self.gesture = GestureState::ViewOffset;
+                            data.niri
+                                .layout
+                                .view_offset_gesture_update(-delta_x, timestamp, false);
+                        }
+                    }
+                    SwipeDirection::Vertical => {
+                        data.niri
+                            .layout
+                            .workspace_switch_gesture_begin(&self.output, false);
+                        self.gesture = GestureState::WorkspaceSwitch;
+                        data.niri
+                            .layout
+                            .workspace_switch_gesture_update(-delta_y, timestamp, false);
+                    }
+                }
+                data.niri.queue_redraw_all();
+            }
+            GestureEvent::Update {
+                delta_x,
+                delta_y,
+                timestamp,
+            } => {
+                let ongoing = match self.gesture {
+                    GestureState::Recognizing | GestureState::Discrete => return false,
+                    GestureState::ViewOffset => data
+                        .niri
+                        .layout
+                        .view_offset_gesture_update(-delta_x, timestamp, false)
+                        .is_some(),
+                    GestureState::WorkspaceSwitch => data
+                        .niri
+                        .layout
+                        .workspace_switch_gesture_update(-delta_y, timestamp, false)
+                        .is_some(),
+                    GestureState::ColumnResize => {
+                        let Some(window) = self.resize_window.as_ref().filter(|w| w.alive())
+                        else {
+                            // The window went away; stop the gesture.
+                            return true;
+                        };
+                        self.resize_dx += delta_x;
+                        data.niri.layout.interactive_resize_update(
+                            window,
+                            Point::from((self.resize_dx, 0.)),
+                        )
+                    }
+                };
+
+                if ongoing {
+                    data.niri.queue_redraw_all();
+                } else {
+                    // Gesture pipeline says stop.
+                    return true;
+                }
+            }
+            GestureEvent::End { .. } => {
+                match self.gesture {
+                    GestureState::Recognizing => {}
+                    GestureState::Discrete => {
+                        // Do NOT run the action here: we are inside a grab
+                        // callback, with the seat's touch mutex held, and
+                        // do_action() -> touch.cancel() would deadlock on it.
+                        // Defer to on_touch_up, which runs after the lock is
+                        // released.
+                        data.niri.pending_touch_action = self.pending_action.take();
+                    }
+                    GestureState::ViewOffset => {
+                        data.niri.layout.view_offset_gesture_end(Some(false));
+                    }
+                    GestureState::WorkspaceSwitch => {
+                        data.niri.layout.workspace_switch_gesture_end(Some(false));
+                    }
+                    GestureState::ColumnResize => {
+                        if let Some(window) = self.resize_window.as_ref().filter(|w| w.alive()) {
+                            data.niri.layout.interactive_resize_end(window);
+                        }
+                    }
+                }
+                data.niri.queue_redraw_all();
+                return true;
+            }
+            GestureEvent::Tap { .. } => {
+                // Taps cannot occur once a gesture grab is installed; nothing to do.
+            }
+            GestureEvent::Cancel => {
+                match self.gesture {
+                    GestureState::Recognizing | GestureState::Discrete => {}
+                    GestureState::ViewOffset => {
+                        data.niri.layout.view_offset_gesture_end(None);
+                    }
+                    GestureState::WorkspaceSwitch => {
+                        data.niri.layout.workspace_switch_gesture_end(None);
+                    }
+                    GestureState::ColumnResize => {
+                        if let Some(window) = self.resize_window.as_ref().filter(|w| w.alive()) {
+                            data.niri.layout.interactive_resize_end(window);
+                        }
+                    }
+                }
+                data.niri.queue_redraw_all();
+                return true;
+            }
+        }
+
+        false
+    }
+
+    /// Begin a live column resize on the focused window, applying the gesture's
+    /// cumulative `delta_x` so far. Returns false when there is nothing to
+    /// resize (no focused window, or the layout refused); the caller then
+    /// falls back to the animated view-offset gesture.
+    fn begin_column_resize(&mut self, data: &mut State, delta_x: f64) -> bool {
+        let Some(window) = data.niri.layout.focus().map(|m| m.window.clone()) else {
+            return false;
+        };
+
+        if !data
+            .niri
+            .layout
+            .interactive_resize_begin(window.clone(), ResizeEdge::RIGHT)
+        {
+            return false;
+        }
+
+        self.gesture = GestureState::ColumnResize;
+        self.resize_window = Some(window.clone());
+        self.resize_dx = delta_x;
+        data.niri
+            .layout
+            .interactive_resize_update(&window, Point::from((delta_x, 0.)));
+
+        true
+    }
+
+    fn on_ungrab(&mut self, data: &mut State) {
+        match self.gesture {
+            GestureState::Recognizing | GestureState::Discrete => {}
+            GestureState::ViewOffset => {
+                data.niri.layout.view_offset_gesture_end(Some(false));
+            }
+            GestureState::WorkspaceSwitch => {
+                data.niri.layout.workspace_switch_gesture_end(Some(false));
+            }
+            GestureState::ColumnResize => {
+                if let Some(window) = self.resize_window.as_ref().filter(|w| w.alive()) {
+                    data.niri.layout.interactive_resize_end(window);
+                }
+            }
+        }
+        data.niri.queue_redraw_all();
+    }
+}
+
+impl TouchGrab<State> for TouchSwipeGrab {
+    fn down(
+        &mut self,
+        data: &mut State,
+        handle: &mut TouchInnerHandle<'_, State>,
+        _focus: Option<(<State as SeatHandler>::TouchFocus, Point<f64, Logical>)>,
+        event: &DownEvent,
+    ) {
+        // Swallowed — passing a null focus through does NOT stop delivery:
+        // smithay routes touch motion to the focus recorded at down time, so
+        // the gesture would keep driving the surface under the fingers.
+        let timestamp = Duration::from_micros(event.time.micros());
+        let ev = self.tracker.touch_down(event.slot, event.location, timestamp);
+        if self.handle_gesture_event(ev, data) {
+            handle.unset_grab(self, data);
+        }
+    }
+
+    fn up(
+        &mut self,
+        data: &mut State,
+        handle: &mut TouchInnerHandle<'_, State>,
+        event: &UpEvent,
+    ) {
+        // Swallowed (see down).
+        let timestamp = Duration::from_micros(event.time.micros());
+        let ev = self.tracker.touch_up(event.slot, timestamp);
+        if self.handle_gesture_event(ev, data) {
+            handle.unset_grab(self, data);
+        }
+    }
+
+    fn motion(
+        &mut self,
+        data: &mut State,
+        handle: &mut TouchInnerHandle<'_, State>,
+        _focus: Option<(<State as SeatHandler>::TouchFocus, Point<f64, Logical>)>,
+        event: &MotionEvent,
+    ) {
+        // Swallowed (see down).
+        let timestamp = Duration::from_micros(event.time.micros());
+        let ev = self
+            .tracker
+            .touch_motion(event.slot, event.location, timestamp);
+        if self.handle_gesture_event(ev, data) {
+            handle.unset_grab(self, data);
+        }
+    }
+
+    fn frame(&mut self, data: &mut State, handle: &mut TouchInnerHandle<'_, State>) {
+        handle.frame(data);
+    }
+
+    fn cancel(&mut self, data: &mut State, handle: &mut TouchInnerHandle<'_, State>) {
+        handle.cancel(data);
+        handle.unset_grab(self, data);
+    }
+
+    fn shape(
+        &mut self,
+        data: &mut State,
+        handle: &mut TouchInnerHandle<'_, State>,
+        event: &ShapeEvent,
+    ) {
+        handle.shape(data, event);
+    }
+
+    fn orientation(
+        &mut self,
+        data: &mut State,
+        handle: &mut TouchInnerHandle<'_, State>,
+        event: &OrientationEvent,
+    ) {
+        handle.orientation(data, event);
+    }
+
+    fn start_data(&self) -> &TouchGrabStartData<State> {
+        &self.start_data
+    }
+
+    fn unset(&mut self, data: &mut State) {
+        self.on_ungrab(data);
+    }
+}
