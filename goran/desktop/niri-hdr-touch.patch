+    }
+
+    /// Drop any in-progress tracking.
+    pub fn reset(&mut self) {
+        self.tracked = None;
+    }
+}
+
+/// Swallows touch events for the remainder of an edge swipe so surfaces under the finger don't
+/// receive a stray drag after the gesture fires.
+pub struct EdgeSwipeGrab {
+    start_data: TouchGrabStartData<State>,
+    slot: TouchSlot,
+}
+
+impl EdgeSwipeGrab {
+    pub fn new(start_data: TouchGrabStartData<State>, slot: TouchSlot) -> Self {
+        Self { start_data, slot }
+    }
+}
+
+impl TouchGrab<State> for EdgeSwipeGrab {
+    fn down(
+        &mut self,
+        _data: &mut State,
+        _handle: &mut TouchInnerHandle<'_, State>,
+        _focus: Option<(<State as SeatHandler>::TouchFocus, Point<f64, Logical>)>,
+        _event: &DownEvent,
+    ) {
+        // Swallowed.
+    }
+
+    fn up(
+        &mut self,
+        data: &mut State,
+        handle: &mut TouchInnerHandle<'_, State>,
+        event: &UpEvent,
+    ) {
+        // Swallowed; release the grab when the initiating finger lifts.
+        if event.slot == self.slot {
+            handle.unset_grab(self, data);
+        }
+    }
+
+    fn motion(
+        &mut self,
+        _data: &mut State,
+        _handle: &mut TouchInnerHandle<'_, State>,
+        _focus: Option<(<State as SeatHandler>::TouchFocus, Point<f64, Logical>)>,
+        _event: &MotionEvent,
+    ) {
+        // Swallowed.
+    }
+
+    fn frame(
+        &mut self,
+        _data: &mut State,
+        _handle: &mut TouchInnerHandle<'_, State>,
+    ) {
+        // Swallowed.
+    }
+
+    fn cancel(
+        &mut self,
+        data: &mut State,
+        handle: &mut TouchInnerHandle<'_, State>,
+    ) {
+        handle.unset_grab(self, data);
+    }
+
+    fn shape(
+        &mut self,
+        _data: &mut State,
+        _handle: &mut TouchInnerHandle<'_, State>,
+        _event: &ShapeEvent,
+    ) {
+        // Swallowed.
+    }
+
+    fn orientation(
+        &mut self,
+        _data: &mut State,
+        _handle: &mut TouchInnerHandle<'_, State>,
+        _event: &OrientationEvent,
+    ) {
+        // Swallowed.
+    }
+
+    fn start_data(&self) -> &TouchGrabStartData<State> {
+        &self.start_data
+    }
+
+    fn unset(&mut self, _data: &mut State) {}
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use smithay::utils::Size;
+
+    fn slot(id: u32) -> TouchSlot {
+        TouchSlot::from(Some(id))
+    }
+
+    fn pt(x: f64, y: f64) -> Point<f64, Logical> {
+        Point::from((x, y))
+    }
+
+    fn geom(x: f64, y: f64, w: f64, h: f64) -> Rectangle<f64, Logical> {
+        Rectangle::new(Point::from((x, y)), Size::from((w, h)))
+    }
+
+    #[test]
+    fn swipe_up_from_bottom_edge_triggers() {
+        let mut tracker = EdgeSwipeTracker::default();
+        assert_eq!(
+            tracker.touch_down(slot(0), pt(500.0, 1270.0), geom(0., 0., 1000., 1280.)),
+            Some(SwipeZone::Bottom)
+        );
+        assert_eq!(tracker.touch_motion(slot(0), pt(500.0, 1240.0)), None);
+        assert_eq!(
+            tracker.touch_motion(slot(0), pt(500.0, 1220.0)),
+            Some(SwipeZone::Bottom)
+        );
+        // Latched: no second trigger.
+        assert_eq!(tracker.touch_motion(slot(0), pt(500.0, 1000.0)), None);
+    }
+
+    #[test]
+    fn swipe_down_from_top_edge_triggers() {
+        let mut tracker = EdgeSwipeTracker::default();
+        assert_eq!(
+            tracker.touch_down(slot(0), pt(500.0, 10.0), geom(0., 0., 1000., 1280.)),
+            Some(SwipeZone::Top)
+        );
+        assert_eq!(tracker.touch_motion(slot(0), pt(500.0, 30.0)), None);
+        assert_eq!(
+            tracker.touch_motion(slot(0), pt(500.0, 60.0)),
+            Some(SwipeZone::Top)
+        );
+    }
+
+    #[test]
+    fn swipe_right_from_left_edge_triggers() {
+        let mut tracker = EdgeSwipeTracker::default();
+        assert_eq!(
+            tracker.touch_down(slot(0), pt(10.0, 640.0), geom(0., 0., 1000., 1280.)),
+            Some(SwipeZone::Left)
+        );
+        assert_eq!(tracker.touch_motion(slot(0), pt(30.0, 640.0)), None);
+        assert_eq!(
+            tracker.touch_motion(slot(0), pt(60.0, 640.0)),
+            Some(SwipeZone::Left)
+        );
+    }
+
+    #[test]
+    fn swipe_left_from_right_edge_triggers() {
+        let mut tracker = EdgeSwipeTracker::default();
+        assert_eq!(
+            tracker.touch_down(slot(0), pt(990.0, 640.0), geom(0., 0., 1000., 1280.)),
+            Some(SwipeZone::Right)
+        );
+        assert_eq!(tracker.touch_motion(slot(0), pt(955.0, 640.0)), None);
+        assert_eq!(
+            tracker.touch_motion(slot(0), pt(950.0, 640.0)),
+            Some(SwipeZone::Right)
+        );
+    }
+
+    #[test]
+    fn wrong_direction_does_not_trigger() {
+        let mut tracker = EdgeSwipeTracker::default();
+        tracker.touch_down(slot(0), pt(500.0, 1270.0), geom(0., 0., 1000., 1280.));
+        // Downward motion from the bottom edge.
+        assert_eq!(tracker.touch_motion(slot(0), pt(500.0, 1300.0)), None);
+        // Mostly-horizontal movement past the threshold.
+        assert_eq!(tracker.touch_motion(slot(0), pt(700.0, 1240.0)), None);
+
+        let mut tracker = EdgeSwipeTracker::default();
+        tracker.touch_down(slot(0), pt(10.0, 640.0), geom(0., 0., 1000., 1280.));
+        // Leftward motion from the left edge.
+        assert_eq!(tracker.touch_motion(slot(0), pt(-30.0, 640.0)), None);
+    }
+
+    #[test]
+    fn corner_swipes_trigger() {
+        let g = geom(0., 0., 1000., 1280.);
+
+        let mut tracker = EdgeSwipeTracker::default();
+        assert_eq!(
+            tracker.touch_down(slot(0), pt(10.0, 10.0), g),
+            Some(SwipeZone::TopLeft)
+        );
+        assert_eq!(tracker.touch_motion(slot(0), pt(25.0, 25.0)), None);
+        assert_eq!(
+            tracker.touch_motion(slot(0), pt(31.0, 31.0)),
+            Some(SwipeZone::TopLeft)
+        );
+
+        let mut tracker = EdgeSwipeTracker::default();
+        assert_eq!(
+            tracker.touch_down(slot(0), pt(990.0, 10.0), g),
+            Some(SwipeZone::TopRight)
+        );
+        assert_eq!(
+            tracker.touch_motion(slot(0), pt(965.0, 35.0)),
+            Some(SwipeZone::TopRight)
+        );
+
+        let mut tracker = EdgeSwipeTracker::default();
+        assert_eq!(
+            tracker.touch_down(slot(0), pt(10.0, 1270.0), g),
+            Some(SwipeZone::BottomLeft)
+        );
+        assert_eq!(
+            tracker.touch_motion(slot(0), pt(35.0, 1245.0)),
+            Some(SwipeZone::BottomLeft)
+        );
+
+        let mut tracker = EdgeSwipeTracker::default();
+        assert_eq!(
+            tracker.touch_down(slot(0), pt(990.0, 1270.0), g),
+            Some(SwipeZone::BottomRight)
+        );
+        assert_eq!(
+            tracker.touch_motion(slot(0), pt(965.0, 1245.0)),
+            Some(SwipeZone::BottomRight)
+        );
+    }
+
+    #[test]
+    fn mostly_straight_swipe_near_corner_does_not_trigger() {
+        let mut tracker = EdgeSwipeTracker::default();
+        assert_eq!(
+            tracker.touch_down(slot(0), pt(10.0, 1270.0), geom(0., 0., 1000., 1280.)),
+            Some(SwipeZone::BottomLeft)
+        );
+        // Mostly-horizontal: dy too small for the corner, dominance fails the bottom edge.
+        assert_eq!(tracker.touch_motion(slot(0), pt(200.0, 1255.0)), None);
+        // Continuing right past any edge threshold still fires nothing.
+        assert_eq!(tracker.touch_motion(slot(0), pt(400.0, 1256.0)), None);
+
+        // Mostly-vertical mirror.
+        let mut tracker = EdgeSwipeTracker::default();
+        assert_eq!(
+            tracker.touch_down(slot(0), pt(10.0, 1270.0), geom(0., 0., 1000., 1280.)),
+            Some(SwipeZone::BottomLeft)
+        );
+        assert_eq!(tracker.touch_motion(slot(0), pt(25.0, 1000.0)), None);
+    }
+
+    #[test]
+    fn corner_zone_wins_over_edges() {
+        assert_eq!(
+            SwipeZone::classify(pt(5.0, 5.0), geom(0., 0., 1000., 1280.)),
+            Some(SwipeZone::TopLeft)
+        );
+        assert_eq!(
+            SwipeZone::classify(pt(995.0, 1275.0), geom(0., 0., 1000., 1280.)),
+            Some(SwipeZone::BottomRight)
+        );
+    }
+
+    #[test]
+    fn touch_outside_edge_zone_ignored() {
+        let mut tracker = EdgeSwipeTracker::default();
+        assert_eq!(
+            tracker.touch_down(slot(0), pt(500.0, 1000.0), geom(0., 0., 1000., 1280.)),
+            None
+        );
+        assert_eq!(tracker.touch_motion(slot(0), pt(500.0, 900.0)), None);
+
+        // Zone boundary: exactly 48px from the bottom edge arms, 49px does not.
+        assert_eq!(
+            tracker.touch_down(slot(1), pt(500.0, 1232.0), geom(0., 0., 1000., 1280.)),
+            Some(SwipeZone::Bottom)
+        );
+        tracker.touch_up(slot(1));
+        assert_eq!(
+            tracker.touch_down(slot(1), pt(500.0, 1231.0), geom(0., 0., 1000., 1280.)),
+            None
+        );
+    }
+
+    #[test]
+    fn second_finger_aborts() {
+        let mut tracker = EdgeSwipeTracker::default();
+        assert_eq!(
+            tracker.touch_down(slot(0), pt(500.0, 1270.0), geom(0., 0., 1000., 1280.)),
+            Some(SwipeZone::Bottom)
+        );
+        assert_eq!(
+            tracker.touch_down(slot(1), pt(600.0, 1270.0), geom(0., 0., 1000., 1280.)),
+            None
+        );
+        assert_eq!(tracker.touch_motion(slot(0), pt(500.0, 1200.0)), None);
+    }
+
+    #[test]
+    fn rearms_after_finger_lifts() {
+        let mut tracker = EdgeSwipeTracker::default();
+        tracker.touch_down(slot(0), pt(500.0, 1270.0), geom(0., 0., 1000., 1280.));
+        assert_eq!(
+            tracker.touch_motion(slot(0), pt(500.0, 1220.0)),
+            Some(SwipeZone::Bottom)
+        );
+        tracker.touch_up(slot(0));
+        assert_eq!(
+            tracker.touch_down(slot(0), pt(500.0, 1270.0), geom(0., 0., 1000., 1280.)),
+            Some(SwipeZone::Bottom)
+        );
+        assert_eq!(
+            tracker.touch_motion(slot(0), pt(500.0, 1220.0)),
+            Some(SwipeZone::Bottom)
+        );
+    }
+
+    #[test]
+    fn geometry_is_per_output() {
+        // The same global point is 10px from the second output's left edge...
+        assert_eq!(
+            SwipeZone::classify(pt(1930.0, 700.0), geom(1920., 0., 1000., 1280.)),
+            Some(SwipeZone::Left)
+        );
+        // ...and mid-screen on the first output (classify assumes the point
+        // lies inside the geometry it is given, as output_under() guarantees).
+        assert_eq!(
+            SwipeZone::classify(pt(1000.0, 700.0), geom(0., 0., 1920., 1280.)),
+            None
+        );
+        // Right edge of the first output.
+        assert_eq!(
+            SwipeZone::classify(pt(1910.0, 700.0), geom(0., 0., 1920., 1280.)),
+            Some(SwipeZone::Right)
+        );
+
+        // End-to-end against the second output's geometry.
+        let mut tracker = EdgeSwipeTracker::default();
+        assert_eq!(
+            tracker.touch_down(slot(0), pt(1930.0, 700.0), geom(1920., 0., 1000., 1280.)),
+            Some(SwipeZone::Left)
+        );
+        assert_eq!(
+            tracker.touch_motion(slot(0), pt(1980.0, 700.0)),
+            Some(SwipeZone::Left)
+        );
+    }
+}
