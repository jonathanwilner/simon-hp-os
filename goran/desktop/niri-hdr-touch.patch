+
+    /// Feed finger motion; returns the fired zone exactly once per stroke.
+    pub fn touch_motion(&mut self, slot: TouchSlot, pos: Point<f64, Logical>) -> Option<SwipeZone> {
+        let tracked = self.tracked.as_mut()?;
+        if tracked.slot != slot || tracked.latched {
