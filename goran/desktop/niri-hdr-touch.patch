+//! Single-finger edge and corner swipe gestures.
+//!
+//! A finger starting within `EDGE_ZONE_PX` of an output edge and swiping inward past
+//! `TRIGGER_PX` fires the action bound to that zone; a finger starting in a corner square and
+//! swiping diagonally inward past `CORNER_TRIGGER_PX` on both axes fires the corner's action.
+//! A grab swallows the remaining touch events so surfaces under the finger don't receive a
+//! stray drag.
+
+use smithay::backend::input::TouchSlot;
+use smithay::input::touch::{
+    DownEvent, GrabStartData as TouchGrabStartData, MotionEvent, OrientationEvent, ShapeEvent,
+    TouchGrab, TouchInnerHandle, UpEvent,
+};
+use smithay::input::SeatHandler;
+use smithay::utils::{Logical, Point, Rectangle};
+
+use crate::niri::State;
+
+/// How close to a screen edge (logical pixels) a touch must start to count as an edge swipe.
+/// Corner zones are the `EDGE_ZONE_PX`-sided squares where two adjacent edge strips overlap.
+const EDGE_ZONE_PX: f64 = 48.0;
+
+/// Inward movement (logical pixels) required to trigger an edge swipe.
+const TRIGGER_PX: f64 = 40.0;
+
+/// Per-axis inward movement (logical pixels) required to trigger a corner swipe, on BOTH
+/// axes — a mostly-straight swipe near a corner fires nothing on purpose. Half of
+/// `TRIGGER_PX`: a 45-degree diagonal covering the same on-screen distance as a straight
+/// edge swipe.
+const CORNER_TRIGGER_PX: f64 = TRIGGER_PX / 2.0;
+
+/// The zone a single-finger swipe started in, relative to the output the touch landed on.
+/// Corners win when the start is within `EDGE_ZONE_PX` of two adjacent edges.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum SwipeZone {
+    Bottom,
+    Top,
+    Left,
+    Right,
+    TopLeft,
+    TopRight,
+    BottomLeft,
+    BottomRight,
+}
+
+impl SwipeZone {
+    /// Classify a start position against an output's global-logical geometry. Returns `None`
+    /// when the position is not in any edge zone. Corner zones take priority over edges;
+    /// within ties the order is deterministic (top row before bottom, left before right) —
+    /// only relevant for outputs smaller than `2 * EDGE_ZONE_PX`.
+    pub fn classify(pos: Point<f64, Logical>, geom: Rectangle<f64, Logical>) -> Option<Self> {
+        let near_left = pos.x - geom.loc.x <= EDGE_ZONE_PX;
+        let near_right = geom.loc.x + geom.size.w - pos.x <= EDGE_ZONE_PX;
+        let near_top = pos.y - geom.loc.y <= EDGE_ZONE_PX;
+        let near_bottom = geom.loc.y + geom.size.h - pos.y <= EDGE_ZONE_PX;
+
+        match (near_top, near_bottom, near_left, near_right) {
+            (true, _, true, _) => Some(Self::TopLeft),
+            (true, _, _, true) => Some(Self::TopRight),
+            (_, true, true, _) => Some(Self::BottomLeft),
+            (_, true, _, true) => Some(Self::BottomRight),
+            (_, true, _, _) => Some(Self::Bottom),
+            (true, _, _, _) => Some(Self::Top),
+            (_, _, true, _) => Some(Self::Left),
+            (_, _, _, true) => Some(Self::Right),
+            (false, false, false, false) => None,
+        }
+    }
+
+    /// Whether movement by `(dx, dy)` from the start position completes this zone's swipe.
+    /// Edges: `TRIGGER_PX` inward with the inward axis dominant (`|inward| >= |along|`).
+    /// Corners: `CORNER_TRIGGER_PX` inward on both axes (deliberately no dominance rule
+    /// and no edge fallback).
+    fn triggered(self, dx: f64, dy: f64) -> bool {
+        match self {
+            Self::Bottom => dy <= -TRIGGER_PX && dy.abs() >= dx.abs(),
+            Self::Top => dy >= TRIGGER_PX && dy.abs() >= dx.abs(),
+            Self::Left => dx >= TRIGGER_PX && dx.abs() >= dy.abs(),
+            Self::Right => dx <= -TRIGGER_PX && dx.abs() >= dy.abs(),
+            Self::TopLeft => dx >= CORNER_TRIGGER_PX && dy >= CORNER_TRIGGER_PX,
+            Self::TopRight => dx <= -CORNER_TRIGGER_PX && dy >= CORNER_TRIGGER_PX,
+            Self::BottomLeft => dx >= CORNER_TRIGGER_PX && dy <= -CORNER_TRIGGER_PX,
+            Self::BottomRight => dx <= -CORNER_TRIGGER_PX && dy <= -CORNER_TRIGGER_PX,
+        }
+    }
+}
+
+#[derive(Debug, Default)]
+pub struct EdgeSwipeTracker {
+    /// The tracked finger and its classified zone, if a single-finger edge gesture is in
+    /// progress.
+    tracked: Option<Tracked>,
+}
+
+#[derive(Debug)]
+struct Tracked {
+    slot: TouchSlot,
+    /// Where the finger started.
+    start: Point<f64, Logical>,
+    /// Zone classified at touch-down from the start position and output geometry; fixed for
+    /// the stroke.
+    zone: SwipeZone,
+    /// Whether the gesture already fired; further motion is ignored until the finger lifts.
+    latched: bool,
+}
+
+impl EdgeSwipeTracker {
+    /// Arm tracking if `pos` falls in an edge/corner zone of `output_geom`. A second finger
