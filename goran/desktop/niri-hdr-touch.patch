+        }
+        if let Some(a) = &part.top {
+            self.top = Some(a.action.clone());
+        }
+        if let Some(a) = &part.left {
+            self.left = Some(a.action.clone());
+        }
+        if let Some(a) = &part.right {
+            self.right = Some(a.action.clone());
+        }
+    }
