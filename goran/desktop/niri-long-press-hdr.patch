+#[cfg(test)]
+mod global_touch_tests {
+    use super::Fixture;
+    use smithay::backend::input::TouchSlot;
+    use std::time::Duration;
+
+    fn held_touch() -> Fixture {
+        let mut fixture = Fixture::new();
+        fixture.add_output(1, (1920, 1080));
+        let state = fixture.niri_state();
+        state.niri.seat.add_touch();
+        let slot = TouchSlot::from(Some(0));
+        let pos = (120.0, 150.0).into();
+        state.niri.touch_swipe_tracker.touch_down(slot, pos, Duration::ZERO);
+        state.niri.touch_long_press = Some((slot, pos));
+        state.niri.touch_long_press_generation = 7;
+        fixture
+    }
+
+    #[test]
+    fn long_press_releases_pointer_and_owns_remainder() {
+        let mut fixture = held_touch();
+        let state = fixture.niri_state();
+        state.finish_touch_long_press(7);
+        assert!(state.niri.touch_input_suspended);
+        assert!(state.niri.touch_long_press.is_none());
+        let pointer = state.niri.seat.get_pointer().unwrap();
+        assert_eq!(pointer.current_location(), (120.0, 150.0).into());
+        assert!(!pointer.is_grabbed());
+    }
+
+    #[test]
+    fn stale_timer_cannot_claim_new_touch() {
+        let mut fixture = held_touch();
+        let state = fixture.niri_state();
+        state.finish_touch_long_press(6);
+        assert!(!state.niri.touch_input_suspended);
+        assert!(state.niri.touch_long_press.is_some());
+        state.niri.touch_long_press = None;
+        state.finish_touch_long_press(7);
+        assert!(!state.niri.touch_input_suspended);
+    }
+
+    #[test]
+    fn multiple_fingers_cannot_right_click() {
+        let mut fixture = held_touch();
+        let state = fixture.niri_state();
+        state.niri.touch_swipe_tracker.touch_down(
+            TouchSlot::from(Some(1)), (130.0, 150.0).into(), Duration::ZERO);
+        state.finish_touch_long_press(7);
+        assert!(!state.niri.touch_input_suspended);
+        assert!(state.niri.touch_long_press.is_none());
+    }
