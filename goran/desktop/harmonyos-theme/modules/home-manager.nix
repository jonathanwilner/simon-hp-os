{ self }:
{
  config,
  lib,
  pkgs,
  ...
}:

let
  cfg = config.jw.harmonyosDmsTheme;
  system = pkgs.stdenv.hostPlatform.system;
  defaultPackage = self.packages.${system}.default;
  themeConfigPath = "${config.xdg.configHome}/DankMaterialShell/themes/harmonyos.json";
in
{
  options.jw.harmonyosDmsTheme = {
    enable = lib.mkEnableOption "the HarmonyOS-inspired DMS/Niri user theme";

    package = lib.mkOption {
      type = lib.types.package;
      default = defaultPackage;
      defaultText = lib.literalExpression "harmonyos-dms-theme.packages.\${pkgs.system}.default";
      description = "Combined theme and HarmonyOS Sans package.";
    };

    applySettings = lib.mkOption {
      type = lib.types.bool;
      default = true;
      description = "Apply the reversible HarmonyOS DMS settings during Home Manager activation.";
    };
  };

  config = lib.mkIf cfg.enable {
    # Keep the proportional and fixed-width sides of the theme in the same
    # Home Manager generation, including focused user-only deployments.
    home.packages = [
      cfg.package
      pkgs.fira
    ];

    xdg.configFile."DankMaterialShell/themes/harmonyos.json".source =
      "${cfg.package}/share/harmonyos-dms-theme/themes/harmonyos.json";
    xdg.configFile."harmonyos-theme/tokens.json".source =
      "${cfg.package}/share/harmonyos-dms-theme/tokens/harmonyos.json";
    # Replace Slazenger's stale generated rule (backed up below) so generic
    # sans-serif users follow the same family as DMS.
    xdg.configFile."fontconfig/conf.d/99-dms-theme-sync.conf" = {
      source = "${cfg.package}/etc/fonts/conf.d/60-harmonyos-sans.conf";
      force = true;
    };

    home.activation.harmonyosDmsFontconfigBackup = lib.hm.dag.entryBefore [ "checkLinkTargets" ] ''
      alias=${lib.escapeShellArg "${config.xdg.configHome}/fontconfig/conf.d/99-dms-theme-sync.conf"}
      backup=${lib.escapeShellArg "${config.xdg.stateHome}/nixos-intc/harmonyos-dms-theme/fontconfig.pre-harmonyos.conf"}
      if [ -f "$alias" ] && [ ! -L "$alias" ] && [ ! -e "$backup" ]; then
        $DRY_RUN_CMD mkdir -p "$(dirname "$backup")"
        $DRY_RUN_CMD install -m600 "$alias" "$backup"
      fi
    '';

    home.activation.harmonyosDmsTheme = lib.mkIf cfg.applySettings (
      lib.hm.dag.entryAfter [ "dmsSettingsInit" ] ''
        $DRY_RUN_CMD ${cfg.package}/bin/harmonyos-theme-apply \
          --theme-file ${lib.escapeShellArg themeConfigPath}
      ''
    );

    # harmonyos-theme-apply may run before Home Manager's reloadSystemd step.
    # Restart the freshly loaded unit afterward so mode-specific terminal and
    # desktop files are generated by this generation on the first activation.
    home.activation.harmonyosDmsThemeSync = lib.hm.dag.entryAfter [ "reloadSystemd" ] ''
      if [ -n "''${XDG_RUNTIME_DIR:-}" ] && [ -S "''${XDG_RUNTIME_DIR}/bus" ]; then
        $DRY_RUN_CMD ${pkgs.systemd}/bin/systemctl --user restart dms-theme-sync.service
      fi
    '';
  };
}
