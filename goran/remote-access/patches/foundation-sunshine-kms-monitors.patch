+    class display_all_t: public display_ram_t {
+    public:
+      explicit display_all_t(mem_type_e mem_type): display_ram_t(mem_type) {}
+
+      struct output_t {
+        std::unique_ptr<display_ram_t> capture;
+        std::shared_ptr<platf::img_t> image;
+        monitors::rect rect;
+        std::string name;
+      };
+      std::vector<output_t> outputs;
+      monitors::canvas canvas;
+      std::chrono::steady_clock::time_point next_layout_check {};
+
+      int init(const ::video::config_t &config) {
+        std::vector<monitors::rect> rects;
+        const auto wayland_outputs = wl::monitors();
+        for (const auto &descriptor : card_descriptors) {
+          for (const auto &[_, output] : descriptor.crtc_to_monitor) {
+            if (!output.active) {
+              continue;
+            }
+            // Logical geometry is required for a mixed-scale Wayland desktop.
+            // Refuse unknown/rotated geometry instead of returning a wrong view.
+            auto live = std::find_if(wayland_outputs.begin(), wayland_outputs.end(), [&](const auto &candidate) {
+              return candidate->name == output.name;
+            });
+            if (live == wayland_outputs.end() || (*live)->transform != WL_OUTPUT_TRANSFORM_NORMAL || output.logical_width <= 0 || output.logical_height <= 0) {
+              BOOST_LOG(error) << "Combined KMS capture requires unrotated Wayland output geometry for " << output.name;
+              return -1;
+            }
+            output_t child;
+            child.name = output.name;
+            child.rect = {output.viewport.offset_x, output.viewport.offset_y, output.logical_width, output.logical_height};
+            child.capture = std::make_unique<display_ram_t>(mem_type);
+            if (child.capture->init(std::to_string(output.monitor_index), config)) {
+              return -1;
+            }
+            // The RAM path does not implement panel-orientation transforms.
+            if (child.capture->card.get_panel_orientation(child.capture->plane_id) != DRM_MODE_ROTATE_0) {
+              BOOST_LOG(error) << "Combined KMS capture does not support a rotated panel: " << output.name;
+              return -1;
+            }
+            if (child.capture->is_hdr()) {
+              BOOST_LOG(error) << "Combined KMS capture requires SDR outputs: " << output.name;
+              return -1;
+            }
+            child.image = child.capture->alloc_img();
+            eglMakeCurrent(child.capture->display.get(), EGL_NO_SURFACE, EGL_NO_SURFACE, EGL_NO_CONTEXT);
+            rects.push_back(child.rect);
+            outputs.emplace_back(std::move(child));
+          }
+        }
+        try {
+          canvas = monitors::layout(rects);
+        }
+        catch (const std::exception &exception) {
+          BOOST_LOG(error) << "Invalid combined desktop: " << exception.what();
+          return -1;
+        }
+        width = canvas.width;
+        height = canvas.height;
+        // Input uses the compositor's complete logical desktop coordinate space.
+        offset_x = canvas.x;
+        offset_y = canvas.y;
+        env_width = ::platf::kms::env_width;
+        env_height = ::platf::kms::env_height;
+        input_scale_x = static_cast<float>(canvas.logical_width) / width;
+        input_scale_y = static_cast<float>(canvas.logical_height) / height;
+        delay = std::chrono::nanoseconds {1s} / std::max(1, std::min(config.framerate, 30));
+        BOOST_LOG(info) << "Combined KMS desktop: " << canvas.logical_width << 'x' << canvas.logical_height
+                        << " logical pixels, " << width << 'x' << height << " capture pixels, " << outputs.size() << " active outputs";
+        return 0;
+      }
+
+      bool layout_unchanged() {
+        auto live = wl::monitors();
+        if (live.size() != outputs.size()) {
+          return false;
+        }
+        for (const auto &output : outputs) {
+          auto found = std::find_if(live.begin(), live.end(), [&](const auto &candidate) {
+            return candidate->name == output.name;
+          });
+          if (found == live.end() || (*found)->transform != WL_OUTPUT_TRANSFORM_NORMAL ||
+              (*found)->logical_width != output.rect.width || (*found)->logical_height != output.rect.height ||
+              (*found)->viewport.offset_x != output.rect.x || (*found)->viewport.offset_y != output.rect.y ||
+              (*found)->viewport.width != output.capture->width || (*found)->viewport.height != output.capture->height) {
+            return false;
+          }
+        }
+        return true;
+      }
+
+      capture_e capture(const push_captured_image_cb_t &push, const pull_free_image_cb_t &pull, bool *cursor) override {
+        auto next_frame = std::chrono::steady_clock::now();
+        while (true) {
+          std::this_thread::sleep_until(next_frame);
+          auto now = std::chrono::steady_clock::now();
+          next_frame = std::max(next_frame + delay, now);
+          if (now >= next_layout_check) {
+            if (!layout_unchanged()) {
+              return capture_e::reinit;
+            }
+            next_layout_check = now + 5s;
+          }
+          std::shared_ptr<platf::img_t> image;
+          if (!pull(image)) {
+            return capture_e::interrupted;
+          }
+          std::memset(image->data, 0, image->row_pitch * image->height);
+          for (auto &output : outputs) {
+            auto status = output.capture->snapshot([&](std::shared_ptr<platf::img_t> &frame) {
+              frame = output.image;
+              return true;
+            }, output.image, 1000ms, *cursor);
+            eglMakeCurrent(output.capture->display.get(), EGL_NO_SURFACE, EGL_NO_SURFACE, EGL_NO_CONTEXT);
+            if (status != capture_e::ok) {
+              return status == capture_e::timeout ? capture_e::reinit : status;
+            }
+            try {
+              monitors::compose(canvas, output.rect, output.image->data, output.image->width, output.image->height,
+                output.image->row_pitch, image->data, image->row_pitch);
+            }
+            catch (const std::exception &exception) {
+              BOOST_LOG(error) << "Combined KMS composition failed: " << exception.what();
+              return capture_e::error;
+            }
+          }
+          image->frame_timestamp = std::chrono::steady_clock::now();
+          if (!push(std::move(image), true)) {
+            return capture_e::ok;
+          }
+        }
+      }
+    };
