+++ b/src/platform/linux/kms_monitors.h
@@ -0,0 +1,66 @@
+#pragma once
+
+#include <algorithm>
+#include <cstdint>
+#include <cstring>
+#include <stdexcept>
+#include <vector>
+
+namespace platf::kms::monitors {
+  struct rect {
+    int x, y, width, height;
+  };
+  struct canvas {
+    int x, y, logical_width, logical_height, width, height;
+  };
+
+  // Bound capture dimensions to the H.264 encoder's common 4096-pixel limit.
+  // Preserve logical geometry separately so input remains accurate after scaling.
+  inline canvas layout(const std::vector<rect> &outputs) {
+    if (outputs.empty()) {
+      throw std::invalid_argument("no active outputs");
+    }
+    int left = outputs.front().x, top = outputs.front().y, right = 0, bottom = 0;
+    for (const auto &output : outputs) {
+      if (output.x < 0 || output.y < 0 || output.width <= 0 || output.height <= 0 ||
+          output.x > 32768 || output.y > 32768 || output.width > 32768 || output.height > 32768) {
+        throw std::invalid_argument("unsupported output geometry");
+      }
+      left = std::min(left, output.x);
+      top = std::min(top, output.y);
+      right = std::max(right, output.x + output.width);
+      bottom = std::max(bottom, output.y + output.height);
+    }
+    const int logical_width = right - left, logical_height = bottom - top;
+    const double scale = std::min(1.0, 4096.0 / std::max(logical_width, logical_height));
+    return {left, top, logical_width, logical_height,
+      std::max(2, static_cast<int>(logical_width * scale) & ~1),
+      std::max(2, static_cast<int>(logical_height * scale) & ~1)};
+  }
+
+  // Scale the physical BGRA scanout to its logical desktop rectangle. Adjacent
+  // rectangles use identical edge rounding; gaps remain the cleared background.
+  inline void compose(const canvas &desktop, const rect &output, const std::uint8_t *source,
+    int source_width, int source_height, int source_pitch, std::uint8_t *target, int target_pitch) {
+    if (!source || !target || source_width <= 0 || source_height <= 0 || source_pitch < source_width * 4 ||
+        target_pitch < desktop.width * 4) {
+      throw std::invalid_argument("invalid BGRA buffer");
+    }
+    const int left = static_cast<std::int64_t>(output.x - desktop.x) * desktop.width / desktop.logical_width;
+    const int top = static_cast<std::int64_t>(output.y - desktop.y) * desktop.height / desktop.logical_height;
+    const int right = static_cast<std::int64_t>(output.x + output.width - desktop.x) * desktop.width / desktop.logical_width;
+    const int bottom = static_cast<std::int64_t>(output.y + output.height - desktop.y) * desktop.height / desktop.logical_height;
+    if (left < 0 || top < 0 || right > desktop.width || bottom > desktop.height || right <= left || bottom <= top) {
+      throw std::invalid_argument("output falls outside canvas");
+    }
+    for (int y = top; y < bottom; ++y) {
+      const int sy = static_cast<std::int64_t>(y - top) * source_height / (bottom - top);
+      auto *dst = target + static_cast<std::size_t>(y) * target_pitch + left * 4;
+      const auto *src = source + static_cast<std::size_t>(sy) * source_pitch;
+      for (int x = left; x < right; ++x, dst += 4) {
+        const int sx = static_cast<std::int64_t>(x - left) * source_width / (right - left);
+        std::memcpy(dst, src + sx * 4, 4);
+      }
+    }
+  }
+}
