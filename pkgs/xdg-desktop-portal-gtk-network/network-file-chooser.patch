+/* Portal clients require file:// URIs. GVFS exposes mounted remote files
+ * through native FUSE paths, including paths for files not yet created. */
+static gboolean
+get_native_selection_uris (GtkFileChooser *chooser,
+                           GSList **uris_out)
+{
+  GSList *files = gtk_file_chooser_get_files (chooser);
+  GSList *uris = NULL;
+  GSList *l;
+  gboolean valid = files != NULL;
+
+  for (l = files; l != NULL && valid; l = l->next)
+    {
+      g_autofree char *path = g_file_get_path (G_FILE (l->data));
+      char *uri = path ? g_filename_to_uri (path, NULL, NULL) : NULL;
+
+      if (uri == NULL)
+        valid = FALSE;
+      else
+        uris = g_slist_prepend (uris, uri);
+    }
+
+  g_slist_free_full (files, g_object_unref);
+  if (!valid)
+    {
+      g_slist_free_full (uris, g_free);
+      return FALSE;
+    }
+
+  *uris_out = g_slist_reverse (uris);
+  return TRUE;
+}
+
