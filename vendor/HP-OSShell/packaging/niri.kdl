// HP-OS-owned session. User's existing Niri config stays unchanged.
// Keep portal D-Bus interfaces on this session's private bus without
// starting the per-user niri/graphical-session systemd targets.
debug { dbus-interfaces-in-non-session-instances; }
hotkey-overlay { skip-at-startup; }
input {
    keyboard { xkb { layout "us"; }; }
    touchpad {
        tap
        tap-button-map "left-middle-right"
        click-method "clickfinger"
        middle-emulation
        natural-scroll
    }
    mouse { middle-emulation; }
}
layout {
    gaps 12
    center-focused-column "on-overflow"
    default-column-width { proportion 0.5; }
    focus-ring { width 2; active-color "#3377ff"; inactive-color "#90949c"; }
}
window-rule {
    geometry-corner-radius 16
    clip-to-geometry true
    shadow { on; }
}
// Native compositor effects require Niri 26.04+. Xray uses wallpaper only.
layer-rule {
    match namespace="^(hpos|quickshell:iris-(chassis|dock|control|settings|notifications|palette|launcher|menu)).*"
    background-effect { blur true; xray true; }
}
include "config.d/50-startup.kdl"
spawn-at-startup "hp-os" "run"
binds {
    Mod+Ctrl+V hotkey-overlay-title="Toggle all windows floating/tiled" { spawn "hp-os-toggle-floating-all"; }
    Mod+Return { spawn "foot"; }
    Mod+Space { spawn "hp-os" "ipc" "hpos" "applications"; }
    Mod+A { spawn "hp-os" "ipc" "hpos" "applications"; }
    Mod+S { spawn "hp-os" "ipc" "hpos" "search"; }
    Mod+C { spawn "hp-os" "ipc" "hpos" "controlCenter"; }
    Mod+Comma { spawn "hp-os" "settings"; }
    Mod+L { spawn "hp-os" "ipc" "lock" "activate"; }
    Mod+Q { close-window; }
    Mod+Left { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+Up { focus-window-up; }
    Mod+Down { focus-window-down; }
    Mod+Shift+Left { move-column-left; }
    Mod+Shift+Right { move-column-right; }
    Mod+Page_Up { focus-workspace-up; }
    Mod+Page_Down { focus-workspace-down; }
    Mod+Shift+Page_Up { move-column-to-workspace-up; }
    Mod+Shift+Page_Down { move-column-to-workspace-down; }
    Mod+V { toggle-window-floating; }
    Mod+F { maximize-column; }
    Mod+Shift+F { fullscreen-window; }
    Mod+Tab { toggle-overview; }
    Mod+Shift+E { quit; }
    XF86AudioRaiseVolume allow-when-locked=true { spawn "hp-os-media-key" "volume-up"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "hp-os-media-key" "volume-down"; }
    XF86AudioMute allow-when-locked=true { spawn "hp-os-media-key" "mute"; }
    XF86MonBrightnessUp { spawn "hp-os-media-key" "brightness-up"; }
    XF86MonBrightnessDown { spawn "hp-os-media-key" "brightness-down"; }
}
