"""Local Recoll index, with a bounded fresh-file fallback. Never index per query."""
import base64
import fcntl
import json
import os
from pathlib import Path
import signal
import stat
import subprocess
import sys
from urllib.parse import unquote, urlparse
from urllib.request import Request, urlopen
import time

TEXT = {'.txt', '.md', '.csv', '.log', '.json', '.yaml', '.yml', '.rst', '.html'}

def search(home, query, limit=8, seconds=1.0):
    terms = query.casefold().split()
    if not terms:
        return []
    deadline = time.monotonic() + seconds
    results = []
    count = 0
    roots = [home / name for name in ('Desktop', 'Documents', 'Downloads', 'Pictures', 'Music', 'Videos')]
    seen = set()
    for root in roots:
        if root.is_symlink():
            continue
        for parent, dirs, files in os.walk(root, followlinks=False):
            dirs[:] = sorted(d for d in dirs if not d.startswith('.') and d not in {'node_modules', 'target', 'build', '__pycache__'})
            for name in sorted(files):
                count += 1
                if count > 30000 or time.monotonic() >= deadline:
                    return results
                path = Path(parent) / name
                if name.startswith('.') or path.is_symlink() or path in seen:
                    continue
                try:
                    if not stat.S_ISREG(path.stat().st_mode):
                        continue
                except OSError:
                    continue
                seen.add(path)
                match = all(term in name.casefold() for term in terms)
                if not match and path.suffix.casefold() in TEXT:
                    try:
                        if path.stat().st_size <= 131072:
                            content = path.read_text(errors='replace').casefold()
                            match = all(term in content for term in terms)
                    except OSError:
                        pass
                if match:
                    results.append({'name': name, 'path': str(path), 'url': path.as_uri()})
                    if len(results) >= limit:
                        return results
    return results

def config_dir():
    return Path(os.environ.get('XDG_STATE_HOME', str(Path.home() / '.local/state'))) / 'hp-os/search'


def configure():
    conf = config_dir()
    conf.mkdir(parents=True, exist_ok=True, mode=0o700)
    roots = [Path.home() / n for n in ('Desktop', 'Documents', 'Downloads', 'Pictures', 'Music', 'Videos')]
    roots = [p for p in roots if p.is_dir() and not p.is_symlink()]
    # An empty topdirs means HOME to Recoll. Use an empty private directory instead.
    empty = conf / 'empty'; empty.mkdir(exist_ok=True)
    config = conf / 'recoll.conf'
    if not config.exists():
        config.write_text('topdirs = ' + ' '.join(json.dumps(str(p), ensure_ascii=False) for p in (roots or [empty])) + '\n' +
            'followLinks = 0\nskippedNames+ = .* node_modules target build __pycache__\n'
            'thrQSizes = -1\nidxflushmb = 20\nfiltermaxseconds = 30\n'
            'pdfocr = 1\nimgocr = 1\nocrprogs = tesseract\ntesseractlang = eng+chi_sim\n')
        (conf / 'mimeconf').write_text('[index]\n' + ''.join('image/' + kind + ' = execm rclimgp.py\n' for kind in ('png', 'jpeg', 'tiff')))
    return conf


def index():
    conf = configure()
    with (conf / 'index.lock').open('w') as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            return
        status = {'state': 'indexing', 'started': time.time()}
        def save():
            tmp = conf / 'status.tmp'
            tmp.write_text(json.dumps(status)); tmp.replace(conf / 'status.json')
        save()
        os.nice(15)
        env = dict(os.environ, OMP_THREAD_LIMIT='1')
        with (conf / 'index.log').open('w') as log:
            try:
                process = subprocess.Popen(['recollindex', '-c', str(conf)], stdout=log, stderr=log, env=env, start_new_session=True)
                def terminate(signum=None, frame=None):
                    try:
                        os.killpg(process.pid, signal.SIGTERM)
                        process.wait(timeout=5)
                    except subprocess.TimeoutExpired:
                        os.killpg(process.pid, signal.SIGKILL); process.wait()
                    except ProcessLookupError:
                        pass
                    if signum is not None:
                        raise SystemExit(128 + signum)
                signal.signal(signal.SIGTERM, terminate)
                signal.signal(signal.SIGINT, terminate)
                try:
                    code = process.wait(timeout=900)
                except subprocess.TimeoutExpired:
                    terminate(); raise
                status.update(state='ready' if code == 0 else 'error', exitCode=code)
            except subprocess.TimeoutExpired:
                status['state'] = 'partial'
            except OSError as error:
                status.update(state='error', error=str(error))
        status['finished'] = time.time(); save()


def status():
    try:
        value = json.loads((config_dir() / 'status.json').read_text())
        # A terminated session cannot leave a permanently active status.
        if value.get('state') == 'indexing' and time.time() - value.get('started', 0) > 920:
            value['state'] = 'interrupted'
        return value
    except (OSError, ValueError):
        return {'state': 'not indexed'}


def indexed_search(query, limit=8):
    if not query.strip() or not (config_dir() / 'xapiandb').exists():
        return []
    try:
        response = subprocess.run(['recollq', '-c', str(config_dir()), '-n', str(limit), '-F', 'url', '-e', '-a', '--', query],
            capture_output=True, text=True, timeout=1.5)
        results = []
        for line in response.stdout.splitlines():
            try:
                url = base64.b64decode(line.strip(), validate=True).decode()
                parsed = urlparse(url)
                if parsed.scheme != 'file' or parsed.netloc not in ('', 'localhost'):
                    continue
                path = Path(unquote(parsed.path))
                if path.is_symlink() or not stat.S_ISREG(path.stat().st_mode):
                    continue
                results.append({'name': path.name, 'path': str(path), 'url': path.as_uri()})
            except (ValueError, UnicodeError, OSError):
                continue
        return results
    except (OSError, subprocess.TimeoutExpired):
        return []


def smart_search(query):
    """Query expansion only: existing loopback model, no documents or downloads."""
    endpoint = os.environ.get('HP_OS_SEARCH_AI_URL', 'http://127.0.0.1:30002/v1').rstrip('/')
    parsed = urlparse(endpoint)
    if parsed.scheme != 'http' or parsed.hostname not in ('127.0.0.1', 'localhost', '::1'):
        return [], 'Local endpoint required'
    def request(path, payload=None, timeout=1):
        body = None if payload is None else json.dumps(payload).encode()
        with urlopen(Request(endpoint + path, data=body, headers={'Content-Type': 'application/json'}), timeout=timeout) as response:
            return json.loads(response.read(65536))
    try:
        models = request('/models').get('data', [])
        model = os.environ.get('HP_OS_SEARCH_AI_MODEL') or models[0]['id']
        response = request('/chat/completions', {
            'model': model, 'temperature': 0, 'max_tokens': 96,
            'response_format': {'type': 'json_schema', 'json_schema': {'name': 'search_queries', 'schema': {'type': 'array', 'items': {'type': 'string'}, 'minItems': 1, 'maxItems': 4}}},
            'messages': [
                {'role': 'system', 'content': 'Convert the user file search request to 1 to 4 short keyword queries for a local full text index. Include useful synonyms or translations. Use plain space-separated content words, no underscores or duplicate queries. Return only a JSON array of strings. Do not answer the request. No explanations.'},
                {'role': 'user', 'content': query[:512] + '\n/no_think'}],
            'chat_template_kwargs': {'enable_thinking': False}}, timeout=20)
        content = response['choices'][0]['message']['content'].strip()
        if content.startswith('```'):
            content = content.split('\n', 1)[1].rsplit('```', 1)[0]
        terms = json.loads(content)
        if not isinstance(terms, list):
            raise ValueError('Expected query list')
        results = []; seen = set()
        for term in [query] + list(dict.fromkeys(t[:160].replace('_', ' ') for t in terms[:4] if isinstance(t, str) and t.strip())):
            for item in indexed_search(term, limit=8):
                if item['url'] not in seen:
                    seen.add(item['url']); results.append(item)
        return results[:8], 'Local Qwen query expansion complete'
    except (OSError, ValueError, KeyError, IndexError, TypeError):
        return [], 'Local Qwen unavailable; showing keyword results'


def main():
    mode = sys.argv[1] if len(sys.argv) > 1 else ''
    query = (sys.argv[2] if len(sys.argv) > 2 else '') if mode == '--query' else mode
    if mode == '--index':
        index(); return
    if mode == '--status':
        print(json.dumps(status())); return
    if mode == '--browse':
        conf = configure()
        # Recoll uses Qt5; remove the shell's Qt6 plugin overrides.
        for key in ('QT_PLUGIN_PATH', 'QML2_IMPORT_PATH', 'QML_IMPORT_PATH'):
            os.environ.pop(key, None)
        os.execvp('recoll', ['recoll', '-c', str(conf), '-q', sys.argv[2] if len(sys.argv) > 2 else ''])
    smart = mode == '--smart'
    if smart:
        query = sys.argv[2] if len(sys.argv) > 2 else ''
        results, smart_status = smart_search(query)
    else:
        results, smart_status = [], ''
    results += indexed_search(query)
    results = list({item['url']: item for item in results}.values())
    seen = {item['url'] for item in results}
    results += [item for item in search(Path.home(), query) if item['url'] not in seen]
    print(json.dumps({'query': query, 'results': results[:8], 'status': status(), 'smartStatus': smart_status}, ensure_ascii=False))

if __name__ == '__main__':
    main()
